{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__p=/$1" }],
  "crons": [{ "path": "/api/cron/daily", "schedule": "17 3 * * *" }]
}
