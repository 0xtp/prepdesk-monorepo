# PerpDesk configuration. Copy to .env (local) or add each value in Vercel → Project → Settings →
# Environment Variables. Empty values fall back to the defaults shown here. Secrets are never logged
# and are masked on the Settings page.

# --- App ---
APP_NAME=PerpDesk                       # shown in the header and page titles
DATABASE_URL=sqlite:///./perpdesk.db    # local default. On Vercel use Postgres, e.g. the Supabase "Transaction pooler" URI (port 6543)
TZ=Asia/Dubai                           # display timezone hint (all stored times are UTC)
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING
AUTH_ENABLED=false                      # true = single-password login for the whole UI
UI_PASSWORD_HASH=                       # bcrypt hash: python -c "import bcrypt;print(bcrypt.hashpw(b'yourpw',bcrypt.gensalt()).decode())"
SESSION_SECRET=                         # random 32+ chars for the session cookie (required if AUTH_ENABLED=true)
PUBLIC_DOMAIN=                          # e.g. desk.example.com; enables secure cookies
CRON_SECRET=                            # random string; scheduled jobs must send "Authorization: Bearer <CRON_SECRET>"

# --- Data sources ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz   # primary data source (public Info API, no key)
COINGECKO_API_KEY=                      # optional free "demo" key (sent as x-cg-demo-api-key); works without one at lower limits
COINGLASS_API_KEY=                      # optional; enables liquidation-cluster levels (information only)
ENABLE_CME_GAP=true                     # CME BTC futures weekend gaps via Yahoo (best effort)
ENABLE_MACRO=true                       # DXY and S&P 500 trend via Yahoo (best effort; weight 0 by default)
ENABLE_EVENT_CALENDAR=true              # high-impact USD events (ForexFactory weekly feed) -> caution flag near CPI/FOMC
DEFAULT_FAVORITES=Majors:BTC,ETH|Large:SOL,HYPE,AVAX,LINK,SUI|Mid:UNI,ONDO,ZEC,AERO,ENA|Memes:PENGU,DOGE   # seeded once; "Group:SYM,SYM|Group:SYM" or "BTC,ETH"
REFRESH_INTERVAL_SEC=120                # dashboard auto-refresh default
HL_RATE_BUDGET_PER_MIN=700              # share of Hyperliquid's 1,200 weight/min/IP the app may use

# --- Analysis ---
TIMEFRAMES=1w,1d,4h,1h,15m              # analysed timeframes
TF_WEIGHTS=0.30,0.25,0.20,0.15,0.10     # one weight per timeframe above; higher timeframes weigh more
TRADING_TIMEFRAME=1h                    # timeframe used for entries/stops (and the backtest)
MIN_CONFIDENCE=60                       # B vs C threshold (0-100)
MAX_ATR_PCTL=95                         # ATR percentile above which a volatility caution flag is set
EVENT_BLACKOUT_HOURS=2                  # caution flag this many hours before a high-impact event
MIN_LIQUIDITY_USD=2000000               # below this 24h volume / pool liquidity: caution flag, grade capped at C
WEIGHTS_TREND=0.30                      # factor-group weights (runtime-editable in Settings)
WEIGHTS_MOMENTUM=0.15
WEIGHTS_STRUCTURE=0.20
WEIGHTS_DERIVATIVES=0.15
WEIGHTS_REGIME=0.15
WEIGHTS_SENTIMENT=0.05
WEIGHTS_MACRO=0.0                       # 0 until the backtest ablation shows macro helps

# --- Trade plan & risk ---
DEFAULT_MARGIN_USD=250                  # isolated margin per trade (editable on each card)
RISK_PCT_OF_MARGIN=8                    # % of margin risked per trade before grade/caution multipliers (max 10)
RISK_USD=                               # optional fixed $ risk; overrides the % if set
ACCOUNT_EQUITY_USD=                     # optional; shows risk as % of your whole account
WATCH_WALLET=                           # optional; your Hyperliquid address (0x…) for the read-only My trades page. Public address only, never a key
MAX_LEVERAGE=10                         # hard leverage cap (the asset's own Hyperliquid max also applies)
MIN_RR=1.5                              # minimum R:R to TP1 after fees and funding; below -> one grade lower + flag
GRADE_A_SIZE=1.0                        # multiplier on base risk per grade
GRADE_B_SIZE=0.5
GRADE_C_SIZE=0.25
CAUTION_SIZE=0.5                        # extra multiplier when any caution flag is set
SL_ATR_BUFFER=0.3                       # stop placed this many ATR beyond the invalidating level
MIN_SL_ATR=0.8                          # stop never closer than this many ATR
MIN_LIQ_BUFFER_ATR=3                    # liquidation must sit at least this many ATR beyond the stop
PLAN_TTL_MIN=60                         # an unfilled plan expires after this many minutes
MAX_HOLD_HOURS=48                       # scorer closes a filled plan at market after this long
TAKER_FEE_BPS=4.5                       # Hyperliquid base tier, verified Oct 2026
MAKER_FEE_BPS=1.5
SLIPPAGE_BPS_MAJOR=3                    # assumed slippage on market/stop orders, Majors & Large
SLIPPAGE_BPS_ALT=8                      # assumed slippage for Mid & Memes

# --- Tracking & quality gates ---
MIN_SAMPLE_FOR_STATS=30                 # live signals needed before stats/warnings count
GATE_MIN_TRADES=100                     # OOS backtest trades needed for grade A
GATE_MIN_EXPECTANCY_R=0.15              # OOS expectancy (R/trade, after costs) needed for grade A
GATE_MIN_PF=1.3                         # profit factor needed for grade A
GATE_MAX_DD_R=15                        # max drawdown in R allowed for grade A
MAX_CALIBRATION_ERROR=0.08              # max gap between predicted and actual win rate before a warning

# --- Optional: LLM explanation (Claude API) ---
ANTHROPIC_API_KEY=                      # enables plain-English explanations (numbers always come from the code)
LLM_MODEL=claude-sonnet-5-5             # $2 / $10 per million input / output tokens
LLM_CREDIT_USD=                         # credit you loaded on console.anthropic.com -> Usage page shows the balance
LLM_CREDIT_SINCE=                       # YYYY-MM-DD the credit was loaded (spend is counted from this date)
LLM_MONTHLY_BUDGET_USD=                 # optional cap; explanations fall back to the built-in summary when reached
ANTHROPIC_ADMIN_KEY=                    # optional sk-ant-admin... key (organisation accounts only) to show billed org cost

# --- Optional: Telegram (read-only alerts in Phase 1) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=              # comma-separated numeric user ids allowed to use /check
TELEGRAM_CHAT_ID=                       # where alerts are sent
TELEGRAM_WEBHOOK_SECRET=                # random string; webhook URL is https://<domain>/api/telegram/<secret>

# --- Phase 2 auto-trader (Auto page). Paper only: simulated trades on live prices, no keys, no orders ---
EXECUTION_MODE=signals                  # signals (off) | paper. Can also be switched on the Auto page
AUTO_COINS=SOL,HYPE,ETH,LINK,SUI,UNI,DOGE,ENA,ONDO,ZEC   # where 4h breakout-long tested positive
AUTO_RISK_PCT=0.5                       # % of equity lost if a stop is hit (max 2)
AUTO_MAX_LEVERAGE=3                     # isolated; leverage is only what the size needs (max 5)
AUTO_MAX_POSITIONS=3
AUTO_DAILY_LOSS_PCT=3                   # pause new entries for the rest of the UTC day
AUTO_MAX_DRAWDOWN_PCT=10                # halt until resumed manually
AUTO_PAPER_EQUITY=500                   # starting paper balance
AUTO_BREAKOUT_LOOKBACK=20               # bars for the breakout high (backtest grid: 20 or 40)
AUTO_MAX_ENTRY_DELAY_MIN=30             # skip a signal noticed later than this after the 4h close
LAB_BOTS=breakdown_short,trend_follow,range_revert,funding_carry   # strategy-lab bots paper-traded alongside
LAB_COINS=SOL,BTC,ETH,HYPE,AVAX,LINK,SUI,UNI,DOGE,ENA,ONDO,ZEC     # coins the lab bots scan
# Live execution is not built. The app refuses to start if EXECUTION_ENABLED=true.
EXECUTION_ENABLED=false
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=
